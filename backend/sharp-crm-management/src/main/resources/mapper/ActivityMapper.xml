<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sharpcrm.mapper.ActivityMapper">

    <select id="findPage" resultType="com.sharpcrm.pojo.Activity">
        select activity.*
        from activity
        <where>
            <if test="activityDto.channel != null">
                and activity.channel = #{activityDto.channel}
            </if>
            <if test="activityDto.type != null">
                and activity.type = #{activityDto.type}
            </if>
        </where>
    </select>

</mapper>
