<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- 继承父工程 sharp-crm-parent，统一管理版本、公共依赖 -->
    <parent>
        <groupId>com.sharpcrm</groupId>
        <artifactId>sharp-crm-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <!-- 当前模块：公共模块 sharp-crm-common，存放工具类、通用实体、全局异常、常量等 -->
    <artifactId>sharp-crm-common</artifactId>

    <properties>
        <!-- JDK编译版本：源码使用JDK17 -->
        <maven.compiler.source>17</maven.compiler.source>
        <!-- 编译后class文件目标兼容JDK17 -->
        <maven.compiler.target>17</maven.compiler.target>
        <!-- 项目编码统一UTF-8，防止中文乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 阿里云OSS SDK，用于文件上传到阿里云OSS（你之前写的OSSUtils工具类） -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
        </dependency>

        <!-- JAXB API，Java对象与XML互相转换，阿里云OSS高版本SDK依赖需要 -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
        </dependency>

        <!-- JavaMail激活框架，文件MIME类型解析，OSS上传依赖 -->
        <dependency>
            <groupId>javax.activation</groupId>
            <artifactId>activation</artifactId>
        </dependency>

        <!-- JAXB运行时实现包，JDK9+移除内置jaxb，需要手动引入实现包，版本不超过2.3.3 -->
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <!-- SpringBoot Web起步依赖，提供web能力、请求接收、MultipartFile文件上传等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JJWT，JWT令牌工具包，用于生成、解析token（登录鉴权） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt</artifactId>
        </dependency>

        <!-- Redis：课程列表缓存、验证码存储（本地降级保证无 Redis 时可用） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- EasyExcel：大文件Excel导入导出，低内存占用 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
        </dependency>

        <!-- 参数校验：JSR-303 注解 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 单元测试依赖，scope=test 不进入生产包 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
