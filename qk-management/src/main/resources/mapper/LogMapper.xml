<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.itcast.mapper.LogMapper">
    <select id="findByPage" resultType="cn.itcast.pojo.OperateLog">
        select  operate_log.*, user.name as operateUserName
        from operate_log
        left join user on operate_log.operate_user_id = user.id
        <where>
            <if test="operateLogDto.operateUserName != null and operateLogDto.operateUserName != ''">
                user.name LIKE CONCAT('%',#{operateLogDto.operateUserName},'%')
            </if>
        </where>

    </select>



</mapper>
